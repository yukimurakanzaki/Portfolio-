---
import Layout from '../layouts/Layout.astro';
---

<Layout title="PM Playbook" description="Interactive Product Management Sandbox: RICE Prioritization & Delivery Flow Simulators.">

  <!-- Header -->
  <section class="relative py-20 border-b border-white/10 overflow-hidden">
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-sky-500/10 rounded-full filter blur-[120px] -z-10 animate-pulse"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <p class="text-sky-400 font-semibold text-sm uppercase tracking-widest mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-ping"></span>
        Interactive Sandbox
      </p>
      <h1 class="text-4xl sm:text-6xl font-extrabold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-sky-400">
        PM Playbook
      </h1>
      <p class="text-slate-300 text-lg max-w-2xl leading-relaxed">
        Don't just read about my product methodology—interact with it. Test backlog prioritization models and simulate how operational frameworks drive velocity and stability.
      </p>
    </div>
  </section>

  <!-- Navigation Tabs -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
    <div class="flex gap-4 border-b border-white/10 pb-4">
      <button 
        id="tab-rice" 
        class="px-5 py-2.5 rounded-lg text-sm font-semibold transition-all bg-sky-500 text-white shadow-lg shadow-sky-500/10"
      >
        🎯 RICE Calculator
      </button>
      <button 
        id="tab-agile" 
        class="px-5 py-2.5 rounded-lg text-sm font-semibold transition-all border border-white/10 text-slate-400 hover:text-white hover:bg-white/5"
      >
        ⚡ Delivery Bottleneck Simulator
      </button>
    </div>
  </section>

  <!-- Main Content -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- TAB 1: RICE Prioritization Calculator -->
    <div id="section-rice" class="space-y-10">
      <div class="grid lg:grid-cols-3 gap-8">
        
        <!-- Sidebar / Description -->
        <div class="lg:col-span-1 space-y-6">
          <div class="border border-white/10 rounded-2xl p-6 bg-white/[0.02] backdrop-blur-md">
            <h2 class="text-xl font-bold text-white mb-4">RICE Framework</h2>
            <p class="text-slate-300 text-sm leading-relaxed mb-4">
              RICE is an objective prioritization framework that balances user reach, product impact, and execution confidence against the engineering effort required.
            </p>
            <div class="text-xs text-slate-400 font-mono space-y-2 border-t border-white/10 pt-4">
              <p class="text-sky-400 font-bold mb-1">Formula:</p>
              <div class="bg-black/30 p-3 rounded-lg text-center font-bold text-sm text-white">
                RICE = (R × I × C) / E
              </div>
              <ul class="space-y-1.5 list-disc list-inside mt-2 text-slate-300">
                <li><strong class="text-white">Reach (R):</strong> Monthly active users impacted.</li>
                <li><strong class="text-white">Impact (I):</strong> Value added (0.25 to 3).</li>
                <li><strong class="text-white">Confidence (C):</strong> Data certainty % (50% to 100%).</li>
                <li><strong class="text-white">Effort (E):</strong> Person-months of labor.</li>
              </ul>
            </div>
          </div>

          <!-- Add custom item form -->
          <div class="border border-white/10 rounded-2xl p-6 bg-white/[0.02]">
            <h3 class="text-sm font-bold text-white mb-4 uppercase tracking-wider">Add Custom Backlog Item</h3>
            <form id="add-item-form" class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1.5">Feature Name</label>
                <input 
                  type="text" 
                  id="new-item-name" 
                  placeholder="e.g., Auto-routing Logic"
                  required
                  class="w-full bg-[#0d1f3c] border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-sky-400"
                />
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-400 mb-1">Reach</label>
                  <input type="number" id="new-item-reach" value="10000" min="1" class="w-full bg-[#0d1f3c] border border-white/10 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-sky-400" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-400 mb-1">Impact (0.25-3)</label>
                  <select id="new-item-impact" class="w-full bg-[#0d1f3c] border border-white/10 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-sky-400">
                    <option value="3">3 (Massive)</option>
                    <option value="2" selected>2 (High)</option>
                    <option value="1">1 (Medium)</option>
                    <option value="0.5">0.5 (Low)</option>
                    <option value="0.25">0.25 (Minimal)</option>
                  </select>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-400 mb-1">Confidence %</label>
                  <select id="new-item-conf" class="w-full bg-[#0d1f3c] border border-white/10 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-sky-400">
                    <option value="1">100% (High)</option>
                    <option value="0.8" selected>80% (Medium)</option>
                    <option value="0.5">50% (Low)</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-400 mb-1">Effort (PM)</label>
                  <input type="number" id="new-item-effort" value="2" min="0.5" step="0.5" class="w-full bg-[#0d1f3c] border border-white/10 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-sky-400" />
                </div>
              </div>
              <button 
                type="submit"
                class="w-full py-2 bg-sky-500 hover:bg-sky-400 text-white font-semibold rounded-lg text-sm transition-all"
              >
                + Add to Backlog
              </button>
            </form>
          </div>
        </div>

        <!-- Calculator Board -->
        <div class="lg:col-span-2 space-y-6">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-white">Backlog Prioritization Board</h2>
            <span class="text-xs text-slate-400">Drag sliders to recalculate score and re-rank</span>
          </div>

          <div id="rice-backlog-container" class="space-y-4">
            <!-- Dynamic items rendered by JS -->
          </div>
        </div>

      </div>
    </div>

    <!-- TAB 2: Delivery Flow Simulator -->
    <div id="section-agile" class="hidden space-y-10 animate-fade-in">
      <div class="grid lg:grid-cols-5 gap-8">
        
        <!-- Controls & Metrics -->
        <div class="lg:col-span-2 space-y-6">
          <div class="border border-white/10 rounded-2xl p-6 bg-white/[0.02]">
            <h2 class="text-xl font-bold text-white mb-2">Delivery Flow Control</h2>
            <p class="text-slate-400 text-sm mb-6">
              Toggle systemic delivery frameworks to simulate how an elite PM optimizes delivery flow, sequences dependencies, and eliminates operational waste over 6 sprints.
            </p>

            <div class="space-y-6">
              
              <!-- Toggle 1 -->
              <label class="flex items-start gap-4 p-4 rounded-xl border border-white/5 bg-white/[0.01] hover:bg-white/[0.03] transition-all cursor-pointer group">
                <input 
                  type="checkbox" 
                  id="toggle-traceability" 
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-sky-500 relative flex-shrink-0 mt-0.5"></div>
                <div>
                  <h3 class="text-white text-sm font-semibold group-hover:text-sky-400 transition-colors">Requirement Traceability (BAF Framework)</h3>
                  <p class="text-slate-400 text-xs mt-1 leading-relaxed">
                    Overhauls the BRD→FSD intake. Drastically minimizes engineering ambiguity and reduces rework on requirements.
                  </p>
                </div>
              </label>

              <!-- Toggle 2 -->
              <label class="flex items-start gap-4 p-4 rounded-xl border border-white/5 bg-white/[0.01] hover:bg-white/[0.03] transition-all cursor-pointer group">
                <input 
                  type="checkbox" 
                  id="toggle-governance" 
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-sky-500 relative flex-shrink-0 mt-0.5"></div>
                <div>
                  <h3 class="text-white text-sm font-semibold group-hover:text-sky-400 transition-colors">Agile Governance & Scrum Cadence</h3>
                  <p class="text-slate-400 text-xs mt-1 leading-relaxed">
                    Establishes structured refinements and daily alignment. Resolves internal blockers and alignment delays quickly.
                  </p>
                </div>
              </label>

              <!-- Toggle 3 -->
              <label class="flex items-start gap-4 p-4 rounded-xl border border-white/5 bg-white/[0.01] hover:bg-white/[0.03] transition-all cursor-pointer group">
                <input 
                  type="checkbox" 
                  id="toggle-epic" 
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-sky-500 relative flex-shrink-0 mt-0.5"></div>
                <div>
                  <h3 class="text-white text-sm font-semibold group-hover:text-sky-400 transition-colors">EPIC Breakdown Optimization (SiCepat Speed)</h3>
                  <p class="text-slate-400 text-xs mt-1 leading-relaxed">
                    Splits features into smaller, independent user stories. Avoids bottlenecks and accelerates sprint throughput velocity.
                  </p>
                </div>
              </label>

            </div>
          </div>

          <!-- Impact Metrics Summary -->
          <div class="grid grid-cols-2 gap-4">
            <div class="border border-white/10 rounded-xl p-4 bg-white/[0.01]">
              <p class="text-slate-500 text-[10px] uppercase font-bold tracking-wider mb-1">Avg. Sprint Velocity</p>
              <p id="avg-velocity-val" class="text-2xl font-black text-white">16.5 pts</p>
              <p class="text-[10px] text-slate-400 mt-1">Story points shipped per sprint</p>
            </div>
            <div class="border border-white/10 rounded-xl p-4 bg-white/[0.01]">
              <p class="text-slate-500 text-[10px] uppercase font-bold tracking-wider mb-1">Requirement Rework</p>
              <p id="avg-rework-val" class="text-2xl font-black text-rose-400">30%</p>
              <p class="text-[10px] text-slate-400 mt-1">Waste due to shifting requirements</p>
            </div>
          </div>
        </div>

        <!-- SVG Line/Area Graph -->
        <div class="lg:col-span-3 border border-white/10 rounded-2xl p-6 bg-[#0c1a2d] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div>
                <h3 class="text-white font-bold">Velocity & Defect/Rework Trend</h3>
                <p class="text-slate-400 text-xs">Simulating sprint outcomes across 6 iterations</p>
              </div>
              <div class="flex items-center gap-4 text-xs font-semibold">
                <span class="flex items-center gap-1.5 text-sky-400">
                  <span class="w-3 h-1 bg-sky-400 rounded"></span> Velocity
                </span>
                <span class="flex items-center gap-1.5 text-rose-400">
                  <span class="w-3 h-1 bg-rose-400 rounded"></span> Rework %
                </span>
              </div>
            </div>

            <!-- SVG Container -->
            <div class="relative w-full aspect-[2/1] bg-black/20 rounded-xl p-4 overflow-hidden border border-white/5">
              <svg id="agile-chart" class="w-full h-full overflow-visible" viewBox="0 0 500 220" xmlns="http://www.w3.org/2000/svg">
                <!-- Grid Lines -->
                <line x1="40" y1="20" x2="460" y2="20" stroke="rgba(255,255,255,0.05)" stroke-dasharray="3,3" />
                <line x1="40" y1="60" x2="460" y2="60" stroke="rgba(255,255,255,0.05)" stroke-dasharray="3,3" />
                <line x1="40" y1="100" x2="460" y2="100" stroke="rgba(255,255,255,0.05)" stroke-dasharray="3,3" />
                <line x1="40" y1="140" x2="460" y2="140" stroke="rgba(255,255,255,0.05)" stroke-dasharray="3,3" />
                <line x1="40" y1="180" x2="460" y2="180" stroke="rgba(255,255,255,0.05)" stroke-dasharray="3,3" />
                
                <!-- Y-Axes Grid/Labels -->
                <text x="32" y="24" class="text-[9px] fill-slate-500 text-right font-mono" text-anchor="end">50 SP</text>
                <text x="32" y="104" class="text-[9px] fill-slate-500 text-right font-mono" text-anchor="end">25 SP</text>
                <text x="32" y="184" class="text-[9px] fill-slate-500 text-right font-mono" text-anchor="end">0 SP</text>

                <text x="468" y="24" class="text-[9px] fill-slate-500 text-left font-mono" text-anchor="start">50%</text>
                <text x="468" y="104" class="text-[9px] fill-slate-500 text-left font-mono" text-anchor="start">25%</text>
                <text x="468" y="184" class="text-[9px] fill-slate-500 text-left font-mono" text-anchor="start">0%</text>

                <!-- X Axis Labels (Sprint 1 - 6) -->
                <text x="40" y="202" class="text-[10px] fill-slate-400 font-bold" text-anchor="middle">S1</text>
                <text x="124" y="202" class="text-[10px] fill-slate-400 font-bold" text-anchor="middle">S2</text>
                <text x="208" y="202" class="text-[10px] fill-slate-400 font-bold" text-anchor="middle">S3</text>
                <text x="292" y="202" class="text-[10px] fill-slate-400 font-bold" text-anchor="middle">S4</text>
                <text x="376" y="202" class="text-[10px] fill-slate-400 font-bold" text-anchor="middle">S5</text>
                <text x="460" y="202" class="text-[10px] fill-slate-400 font-bold" text-anchor="middle">S6</text>

                <!-- Chart Paths (Rendered dynamically by JS) -->
                <path id="velocity-path-area" d="" fill="url(#velocity-gradient)" class="transition-all duration-500 ease-in-out" />
                <path id="velocity-path" d="" fill="none" stroke="#38bdf8" stroke-width="3.5" stroke-linecap="round" class="transition-all duration-500 ease-in-out" />
                
                <path id="rework-path-area" d="" fill="url(#rework-gradient)" class="transition-all duration-500 ease-in-out" />
                <path id="rework-path" d="" fill="none" stroke="#f87171" stroke-width="3" stroke-linecap="round" class="transition-all duration-500 ease-in-out" />

                <!-- Gradients -->
                <defs>
                  <linearGradient id="velocity-gradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.15" />
                    <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.0" />
                  </linearGradient>
                  <linearGradient id="rework-gradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#f87171" stop-opacity="0.12" />
                    <stop offset="100%" stop-color="#f87171" stop-opacity="0.0" />
                  </linearGradient>
                </defs>
                
                <!-- Dynamic Nodes / Dots Container -->
                <g id="chart-dots" class="transition-all duration-500 ease-in-out"></g>
              </svg>
            </div>
          </div>

          <div class="mt-4 border-t border-white/5 pt-4">
            <h4 class="text-xs font-semibold text-slate-300 mb-1.5">Operational Insights:</h4>
            <p id="agile-sim-insight" class="text-xs text-slate-400 leading-relaxed">
              With baseline operations, team capacity is flat, and 30% of each sprint is wasted in requirement rework due to ambiguous handoffs. Toggle PM frameworks to fix the leak.
            </p>
          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- CTA Back to case studies -->
  <section class="py-16 border-t border-white/10 mt-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-white font-bold text-lg mb-2">Want to read how these playbooks were run in real projects?</h3>
      <p class="text-slate-400 text-sm mb-6 max-w-lg mx-auto">Explore BAF, Danamas, and SiCepat case studies to see details on execution and metrics.</p>
      <a href="/case-studies" class="inline-flex items-center justify-center px-6 py-3 border border-sky-400/40 text-sky-400 hover:bg-sky-400/10 font-semibold rounded-lg transition-colors">
        Read Case Studies
      </a>
    </div>
  </section>

  <!-- Tab Toggle & Core Simulator Logic -->
  <script>
    // --- TAB TOGGLE LOGIC ---
    const tabRice = document.getElementById('tab-rice');
    const tabAgile = document.getElementById('tab-agile');
    const secRice = document.getElementById('section-rice');
    const secAgile = document.getElementById('section-agile');

    tabRice?.addEventListener('click', () => {
      tabRice.className = 'px-5 py-2.5 rounded-lg text-sm font-semibold transition-all bg-sky-500 text-white shadow-lg shadow-sky-500/10';
      tabAgile.className = 'px-5 py-2.5 rounded-lg text-sm font-semibold transition-all border border-white/10 text-slate-400 hover:text-white hover:bg-white/5';
      secRice?.classList.remove('hidden');
      secAgile?.classList.add('hidden');
    });

    tabAgile?.addEventListener('click', () => {
      tabAgile.className = 'px-5 py-2.5 rounded-lg text-sm font-semibold transition-all bg-sky-500 text-white shadow-lg shadow-sky-500/10';
      tabRice.className = 'px-5 py-2.5 rounded-lg text-sm font-semibold transition-all border border-white/10 text-slate-400 hover:text-white hover:bg-white/5';
      secAgile?.classList.remove('hidden');
      secRice?.classList.add('hidden');
      // Redraw chart when section shows up to ensure sizes are correct
      runDeliverySimulation();
    });

    // --- RICE CALCULATOR LOGIC ---
    let backlog = [
      { id: '1', name: 'Bank API Payment Rails Integration', reach: 80000, impact: 3, confidence: 0.9, effort: 6 },
      { id: '2', name: 'Biometric KYC / Identity Verification Flow', reach: 100000, impact: 2, confidence: 0.8, effort: 4 },
      { id: '3', name: 'Driver Routing Optimization Engine', reach: 20000, impact: 3, confidence: 0.7, effort: 3 },
      { id: '4', name: 'Merchant Disbursal Console Overhaul', reach: 5000, impact: 1, confidence: 0.95, effort: 2 }
    ];

    function calculateRice(item) {
      return Math.round((item.reach * item.impact * item.confidence) / item.effort);
    }

    function renderBacklog() {
      const container = document.getElementById('rice-backlog-container');
      if (!container) return;

      // Sort by RICE score descending
      const sortedBacklog = [...backlog].sort((a, b) => calculateRice(b) - calculateRice(a));

      container.innerHTML = '';
      sortedBacklog.forEach((item, index) => {
        const score = calculateRice(item);
        const cardHtml = `
          <div class="group border border-white/10 rounded-2xl p-6 bg-[#0d1f3c]/60 hover:bg-[#0d1f3c]/90 hover:border-sky-400/30 transition-all duration-300 relative flex flex-col md:flex-row md:items-center justify-between gap-6" data-id="${item.id}">
            <!-- Left: Rank & Title -->
            <div class="flex-1 flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-black flex items-center justify-center flex-shrink-0 mt-0.5 shadow-[0_0_15px_rgba(56,189,248,0.1)]">
                #${index + 1}
              </div>
              <div>
                <h4 class="text-white font-bold text-base leading-snug group-hover:text-sky-300 transition-colors">${item.name}</h4>
                <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-xs text-slate-400 font-mono">
                  <span>R: <strong class="text-slate-200">${item.reach.toLocaleString()}</strong></span>
                  <span>I: <strong class="text-slate-200">${item.impact}</strong></span>
                  <span>C: <strong class="text-slate-200">${Math.round(item.confidence * 100)}%</strong></span>
                  <span>E: <strong class="text-slate-200">${item.effort} PM</strong></span>
                </div>
              </div>
            </div>

            <!-- Middle: Sliders -->
            <div class="grid grid-cols-2 md:flex md:items-center gap-4 md:gap-6 flex-1 max-w-sm">
              <div class="space-y-1 flex-1">
                <span class="text-[10px] text-slate-500 uppercase font-bold font-mono metric-label-impact-${item.id}">Impact (${item.impact})</span>
                <input 
                  type="range" 
                  min="0.25" 
                  max="3" 
                  step="0.25" 
                  value="${item.impact}" 
                  class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-sky-400"
                  onchange="updateMetric('${item.id}', 'impact', parseFloat(this.value))"
                  oninput="document.querySelector('.metric-label-impact-${item.id}').textContent = 'Impact (' + this.value + ')'"
                />
              </div>
              <div class="space-y-1 flex-1">
                <span class="text-[10px] text-slate-500 uppercase font-bold font-mono metric-label-effort-${item.id}">Effort (${item.effort} PM)</span>
                <input 
                  type="range" 
                  min="0.5" 
                  max="10" 
                  step="0.5" 
                  value="${item.effort}" 
                  class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-sky-400"
                  onchange="updateMetric('${item.id}', 'effort', parseFloat(this.value))"
                  oninput="document.querySelector('.metric-label-effort-${item.id}').textContent = 'Effort (' + this.value + ' PM)'"
                />
              </div>
            </div>

            <!-- Right: Score & Actions -->
            <div class="flex items-center justify-between md:justify-end gap-6 flex-shrink-0">
              <div class="text-right">
                <p class="text-[9px] text-slate-500 uppercase font-bold tracking-widest font-mono">RICE SCORE</p>
                <p class="text-2xl font-black text-sky-400 drop-shadow-[0_0_8px_rgba(56,189,248,0.2)]">${score.toLocaleString()}</p>
              </div>
              <button 
                onclick="deleteItem('${item.id}')"
                class="p-2 border border-white/5 rounded-lg text-slate-500 hover:text-rose-400 hover:bg-rose-500/5 hover:border-rose-500/20 transition-all"
                title="Delete item"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </div>
        `;
        container.insertAdjacentHTML('beforeend', cardHtml);
      });
    }

    // Attach callbacks to global window object so inline attributes can access them
    (window as any).updateMetric = function(id: string, key: string, val: number) {
      backlog = backlog.map(item => item.id === id ? { ...item, [key]: val } : item);
      renderBacklog();
    };

    (window as any).deleteItem = function(id: string) {
      backlog = backlog.filter(item => item.id !== id);
      renderBacklog();
    };

    // Form logic
    const addItemForm = document.getElementById('add-item-form');
    addItemForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('new-item-name') as HTMLInputElement).value;
      const reach = parseInt((document.getElementById('new-item-reach') as HTMLInputElement).value);
      const impact = parseFloat((document.getElementById('new-item-impact') as HTMLSelectElement).value);
      const confidence = parseFloat((document.getElementById('new-item-conf') as HTMLSelectElement).value);
      const effort = parseFloat((document.getElementById('new-item-effort') as HTMLInputElement).value);

      backlog.push({
        id: Date.now().toString(),
        name,
        reach,
        impact,
        confidence,
        effort
      });

      renderBacklog();
      addItemForm.reset();
    });

    // Initial render
    renderBacklog();

    // --- DELIVERY FLOW SIMULATION LOGIC ---
    const tTraceability = document.getElementById('toggle-traceability') as HTMLInputElement;
    const tGovernance = document.getElementById('toggle-governance') as HTMLInputElement;
    const tEpic = document.getElementById('toggle-epic') as HTMLInputElement;

    tTraceability?.addEventListener('change', runDeliverySimulation);
    tGovernance?.addEventListener('change', runDeliverySimulation);
    tEpic?.addEventListener('change', runDeliverySimulation);

    function runDeliverySimulation() {
      const isTrace = tTraceability?.checked ?? false;
      const isGov = tGovernance?.checked ?? false;
      const isEpic = tEpic?.checked ?? false;

      // Base models
      const baseVelocity = [15, 17, 16, 18, 17, 19];
      const baseRework = [30, 29, 32, 28, 31, 30];

      // Recalculate arrays
      let velocity = [...baseVelocity];
      let rework = [...baseRework];

      // Apply modifications
      if (isTrace) {
        rework = [30, 18, 12, 8, 6, 5]; // Big rework drop (Adi's BAF project)
        velocity = velocity.map((v, i) => v + (i >= 1 ? 3 : 1)); // Less wasted effort raises velocity
      }
      if (isGov) {
        velocity = velocity.map(v => v + 4); // Quick block resolving raises average baseline
        rework = rework.map(r => Math.max(3, Math.round(r * 0.8))); // Communication lowers rework slightly
      }
      if (isEpic) {
        // Compound growth from smaller stories (Adi's SiCepat optimization)
        velocity = velocity.map((v, i) => v + i * 2.5);
        rework = rework.map((r, i) => Math.max(3, Math.round(r - i * 1.5)));
      }

      // Cap rework values just in case
      rework = rework.map(r => Math.min(100, Math.max(0, r)));

      // Render stats
      const avgVel = Math.round((velocity.reduce((a, b) => a + b, 0) / 6) * 10) / 10;
      const avgRew = Math.round(rework.reduce((a, b) => a + b, 0) / 6);
      
      const elAvgVel = document.getElementById('avg-velocity-val');
      const elAvgRew = document.getElementById('avg-rework-val');
      if (elAvgVel) elAvgVel.textContent = `${avgVel} SP`;
      if (elAvgRew) {
        elAvgRew.textContent = `${avgRew}%`;
        elAvgRew.className = `text-2xl font-black ${avgRew > 20 ? 'text-rose-400' : avgRew > 10 ? 'text-amber-400' : 'text-emerald-400'}`;
      }

      // Build insights copy
      const insightEl = document.getElementById('agile-sim-insight');
      if (insightEl) {
        let copy = '';
        if (!isTrace && !isGov && !isEpic) {
          copy = "With baseline operations, team capacity is flat, and 30% of each sprint is wasted in requirement rework due to ambiguous handoffs. Toggle PM frameworks to fix the leak.";
        } else if (isTrace && !isGov && !isEpic) {
          copy = "<strong>Requirement Traceability Active</strong>: Bridging requirements directly to technical design cuts requirement rework to just 5% in Sprint 6. Team velocity stabilizes upward.";
        } else if (!isTrace && isGov && !isEpic) {
          copy = "<strong>Agile Governance Active</strong>: Establishing clear Scrum ceremonies unblocks developers instantly. Baseline velocity spikes by 4 story points across the board.";
        } else if (!isTrace && !isGov && isEpic) {
          copy = "<strong>EPIC Breakdown Active</strong>: Splitting complex scopes into small stories yields steady 18% MoM velocity compounding as items flow easily through the pipeline.";
        } else if (isTrace && isGov && isEpic) {
          copy = "<strong>All frameworks active!</strong> You've successfully created a high-performing product team. Ambiguity is gone, communication is fast, and story sizes are optimal—pushing velocity to ~40SP with near-zero waste.";
        } else {
          copy = "Combined frameworks are reinforcing team metrics, improving overall cadence, and cutting waste. Hover over chart nodes to see sprint metrics.";
        }
        insightEl.innerHTML = copy;
      }

      // Draw SVG chart paths
      drawChartPaths(velocity, rework);
    }

    function drawChartPaths(velocity: number[], rework: number[]) {
      const vPath = document.getElementById('velocity-path');
      const vArea = document.getElementById('velocity-path-area');
      const rPath = document.getElementById('rework-path');
      const rArea = document.getElementById('rework-path-area');
      const dotsGroup = document.getElementById('chart-dots');
      if (!vPath || !vArea || !rPath || !rArea || !dotsGroup) return;

      // Map values to coordinates
      // X values: Sprint 1 = 40, Sprint 6 = 460. Gap = 84px
      // Y values: 0 to 180 coordinate space for charts (top is 20, bottom is 180. Height = 160px)
      // Velocity range: 0 to 50 SP -> Y = 180 - (val / 50) * 160
      // Rework range: 0% to 50% -> Y = 180 - (val / 50) * 160

      const getCoords = (val: number, isPct: boolean, index: number) => {
        const x = 40 + index * 84;
        const maxVal = 50; // Max for both axes
        const y = 180 - (Math.min(maxVal, val) / maxVal) * 160;
        return { x, y };
      };

      let vPoints = velocity.map((val, i) => getCoords(val, false, i));
      let rPoints = rework.map((val, i) => getCoords(val, true, i));

      // Build SVG Path strings
      const buildLineD = (points: {x: number, y: number}[]) => {
        return `M ${points[0].x} ${points[0].y} ` + points.slice(1).map(p => `L ${p.x} ${p.y}`).join(' ');
      };

      const buildAreaD = (points: {x: number, y: number}[]) => {
        const linePart = buildLineD(points);
        return `${linePart} L ${points[points.length - 1].x} 180 L ${points[0].x} 180 Z`;
      };

      vPath.setAttribute('d', buildLineD(vPoints));
      vArea.setAttribute('d', buildAreaD(vPoints));

      rPath.setAttribute('d', buildLineD(rPoints));
      rArea.setAttribute('d', buildAreaD(rPoints));

      // Clear and draw dots with tooltips
      dotsGroup.innerHTML = '';
      vPoints.forEach((p, i) => {
        // Velocity dot (sky)
        dotsGroup.insertAdjacentHTML('beforeend', `
          <circle cx="${p.x}" cy="${p.y}" r="5" fill="#0c1a2d" stroke="#38bdf8" stroke-width="2.5" class="cursor-pointer hover:r-7 transition-all" />
          <text x="${p.x}" y="${p.y - 10}" class="text-[9px] fill-sky-400 font-bold opacity-0 hover:opacity-100 transition-opacity font-mono" text-anchor="middle">${velocity[i]} SP</text>
        `);
      });

      rPoints.forEach((p, i) => {
        // Rework dot (rose)
        dotsGroup.insertAdjacentHTML('beforeend', `
          <circle cx="${p.x}" cy="${p.y}" r="4" fill="#0c1a2d" stroke="#f87171" stroke-width="2" class="cursor-pointer hover:r-6 transition-all" />
          <text x="${p.x}" y="${p.y - 10}" class="text-[9px] fill-rose-400 font-bold opacity-0 hover:opacity-100 transition-opacity font-mono" text-anchor="middle">${rework[i]}%</text>
        `);
      });
    }

    // Run first time
    runDeliverySimulation();
  </script>

</Layout>
