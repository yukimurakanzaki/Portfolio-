---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Senior Product Manager in Jakarta with 4+ years in fintech.">

  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">
    <div class="absolute top-1/4 -left-20 w-96 h-96 bg-sky-500 rounded-full mix-blend-multiply filter blur-[160px] opacity-10"></div>
    <div class="absolute bottom-1/4 -right-20 w-96 h-96 bg-blue-600 rounded-full mix-blend-multiply filter blur-[160px] opacity-10"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid lg:grid-cols-5 gap-12 items-center">

        <!-- Text block -->
        <div class="lg:col-span-3">
          <p class="text-sky-400 font-semibold text-sm uppercase tracking-widest mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-sky-400 animate-ping"></span>
            Senior Delivery PM · Jakarta
          </p>

          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold leading-snug mb-6 bg-clip-text text-transparent bg-gradient-to-br from-white via-slate-200 to-sky-400">
            End-to-End Delivery<br />
            <span class="text-sky-400">For Regulated Fintech.</span>
          </h1>

          <p class="text-slate-300 text-lg sm:text-xl leading-relaxed mb-10 max-w-xl">
            4+ years shipping zero-defect credit and payment rails under hard OJK and resource constraints. I take half-formed intent, sequence dependencies, and execute without the overhead.
          </p>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <a
              href="/case-studies"
              class="inline-flex items-center justify-center px-7 py-3.5 bg-sky-500 hover:bg-sky-400 text-white font-semibold rounded-lg transition-colors shadow-lg shadow-sky-500/20"
            >
              View Case Studies
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-7 py-3.5 border border-slate-700 text-slate-300 hover:text-white hover:border-slate-500 hover:bg-slate-800/50 font-semibold rounded-lg transition-all"
            >
              Get in Touch
            </a>
            <a
              href="/MuhammadAdiPutra_CV.pdf"
              download
              class="inline-flex items-center justify-center gap-2 text-sky-400 hover:text-sky-300 font-medium transition-colors ml-0 sm:ml-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Download CV
            </a>
          </div>
        </div>

        <!-- Profile photo -->
        <div class="lg:col-span-2 flex justify-center">
          <div class="relative">
            <div class="absolute inset-0 rounded-full bg-sky-500/20 blur-2xl scale-110 pointer-events-none"></div>
            <img
              src="/images/profile.jpg"
              alt="Muhammad Adi Putra — Senior Product Manager Jakarta"
              class="relative w-64 h-64 lg:w-80 lg:h-80 rounded-full object-cover object-top border-2 border-sky-400/30 shadow-2xl"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="border-t border-white/10 py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {[
          { value: '4+', label: 'Years in Fintech' },
          { value: '19', label: 'Engineers Directly Led' },
          { value: '0', label: 'Production Defects' },
          { value: '30%', label: 'Rework Reduced' },
        ].map(stat => (
          <div class="text-center group">
            <div class="text-4xl font-extrabold text-white group-hover:text-sky-400 transition-colors mb-1 drop-shadow-[0_0_10px_rgba(56,189,248,0.3)]">{stat.value}</div>
            <div class="text-slate-400 text-sm uppercase tracking-widest font-semibold">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Work Preview -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-white">Featured Work</h2>
        <a href="/case-studies" class="text-sky-400 hover:text-sky-300 text-sm font-medium transition-colors">
          View all →
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            company: 'PT Bussan Auto Finance (BAF)',
            title: 'Zero-Defect Delivery: Coordinating 19 Engineers',
            desc: 'Shipped core releases with zero defects under OJK compliance without a dedicated BA or Scrum Master by designing a custom requirement traceability framework.',
            tags: ['Compliance', 'Product Ops', 'Delivery Leadership'],
          },
          {
            company: 'Danamas (Sinarmas Group)',
            title: 'Lending Infrastructure: Shipping 3 Bank Rails',
            desc: 'Oversaw end-to-end bank integrations to expand active lending pools, managing complex partner dependencies and multi-party SIT/UAT validation workflows.',
            tags: ['Fintech', 'API Rails', 'Dependency Management'],
          },
          {
            company: 'SiCepat Ekspres',
            title: 'Compounding Throughput: 18% MoM Speed',
            desc: 'Accelerated nationwide feature rollouts by optimising EPIC breakdowns, turning complex and ambiguous product requirements into clean, testable user stories.',
            tags: ['Logistics Ops', 'Backlog Slicing', 'Agile Velocity'],
          },
        ].map(item => (
          <a
            href="/case-studies"
            class="group block border border-white/10 rounded-2xl p-8 lg:p-10 bg-white/5 backdrop-blur-sm hover:bg-white/10 hover:border-sky-400/30 hover:shadow-[0_0_30px_-10px_rgba(56,189,248,0.2)] transition-all duration-300 hover:-translate-y-1"
          >
            <p class="text-sky-400 text-xs font-semibold uppercase tracking-wider mb-2">{item.company}</p>
            <h3 class="text-white font-bold text-lg mb-3 group-hover:text-sky-300 transition-colors">{item.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-4">{item.desc}</p>
            <div class="flex flex-wrap gap-2">
              {item.tags.map(tag => (
                <span class="px-3 py-1 border border-sky-400/20 text-sky-300 text-xs rounded-full">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
        Looking for a PM or consultant?
      </h2>
      <p class="text-slate-400 mb-8 max-w-lg mx-auto">
        Whether you need embedded product leadership or help structuring your own PM portfolio — let's talk.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-3 bg-sky-500 hover:bg-sky-400 text-white font-semibold rounded-lg transition-colors"
      >
        Start a Conversation
      </a>
    </div>
  </section>

</Layout>
