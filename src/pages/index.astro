---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ScreenPlate from '../components/ScreenPlate.astro';
import Ledger from '../components/Ledger.astro';
import CopyEmail from '../components/CopyEmail.astro';
import LocalTime from '../components/LocalTime.astro';
import portrait from '../assets/profile.jpg';
import { career } from '../data/career';
import { site, cvSize, typo } from '../lib/site';
import { sortStudies, studyMeta } from '../lib/study';

const studies = sortStudies(await getCollection('case-studies'));
const titleOf = (slug: string) => typo(studies.find((s) => s.data.slug === slug)?.data.title ?? '');

// Each capability links to the case study that proves it.
const capabilities = [
  {
    name: 'Payment rails',
    text: 'I scope, sequence and ship third-party payment integrations. One payment channel became several methods across banks and e-wallets.',
    slug: 'shipping-payment-gateway-integration',
  },
  {
    name: 'Lending platforms',
    text: 'I led a lender platform’s move off an aging legacy system, with no data loss and no unplanned downtime while lending kept running.',
    slug: 'rebuilding-fintech-lending-platform',
  },
  {
    name: 'Delivery systems',
    text: 'I built sprint governance from scratch across three squads, without dedicated Scrum Master, BA or TPM support, and roughly halved BRD-to-development cycle time.',
    slug: 'cutting-cycle-time',
  },
  {
    name: 'Zero to one',
    text: 'As sole PM I took a personal finance tool to a cloud-syncing, multi-tenant beta in 8 days.',
    slug: 'fi-dashboard-personal-to-product',
  },
];

const tools = 'Jira, Figma, Confluence, Miro, Postman, Notion, Mixpanel (basic), SQL (basic), AI productivity tools';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Product Manager',
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  sameAs: [site.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
  knowsAbout: ['Product management', 'Fintech', 'Payments', 'Lending'],
};
---

<Layout title="Home" description="Product manager in Jakarta. Payments, lending and internal platforms in regulated fintech. Open to Senior and Lead PM roles in Indonesia and SEA.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />

  <!-- Hero -->
  <section class="page grid12 pt-[clamp(2.5rem,6vw,5rem)] pb-[clamp(4rem,8vw,7rem)]">
    <div class="col-span-12 flex flex-col gap-1 sm:flex-row sm:justify-between sm:gap-6 field-note">
      <span>Product Manager — fintech, payments, lending</span>
      <span>Jakarta {site.coords}<LocalTime sep /></span>
    </div>

    <h1 class="t-hero col-span-12 mt-10 sm:mt-16 lg:col-span-9 lg:row-start-2">
      I own regulated fintech products — from <em><span class="whitespace-nowrap">half-formed</span> requirements</em> to production.
    </h1>

    <p class="col-span-12 mt-8 flex items-center gap-3 lg:col-span-9 lg:row-start-3">
      <span class="signal-dot" aria-hidden="true"></span>
      <span>{site.status}</span>
    </p>

    <div class="col-span-12 mt-8 flex flex-wrap items-center gap-x-8 gap-y-5 lg:col-span-9 lg:row-start-4">
      <a href="#work" class="btn">Selected work <span aria-hidden="true">↓</span></a>
      <CopyEmail />
      <a href={site.cv} download class="link">CV — PDF, {cvSize}</a>
    </div>

    <figure class="col-span-12 mt-14 max-w-[15rem] lg:col-start-10 lg:col-span-3 lg:row-start-2 lg:row-span-3 lg:mt-0 lg:max-w-none lg:self-end">
      <Picture
        src={portrait}
        alt="Portrait of Muhammad Adi Putra"
        widths={[320, 480, 717]}
        sizes="(min-width: 1024px) 24vw, 15rem"
        formats={['avif', 'webp']}
        quality={70}
        loading="eager"
        class="block w-full"
        style="aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); filter: grayscale(1) contrast(1.05);"
      />
      <figcaption class="field-note mt-3">Fig. 1 — Muhammad Adi Putra, Jakarta</figcaption>
    </figure>
  </section>

  <div class="meridian">
    <!-- §01 Selected work -->
    <section id="work" class="section">
      <div class="page grid12">
        <div class="label-col lg:pt-2">
          <p class="t-label">§01</p>
          <p class="field-note mt-1">{studies.length} case studies</p>
        </div>
        <div class="content-col"><h2 class="t-section">Selected work</h2></div>
      </div>

      <ol class="page mt-12">
        {studies.map((study, i) => {
          const m = studyMeta(study);
          return (
            <li class="index-row">
              <a href={`/case-studies/${study.data.slug}`} class="index-link grid12">
                <div class="label-col field-note tnum">
                  <span class="block">{String(i + 1).padStart(2, '0')}</span>
                  <span class="block">{study.data.readTime}</span>
                </div>
                <div class="content-col grid gap-3">
                  <div class="flex items-start justify-between gap-6">
                    <h3 class="row-title" style={`view-transition-name: study-${study.data.slug}`}>{typo(study.data.title)}</h3>
                    <span class="arrow t-section" aria-hidden="true">→</span>
                  </div>
                  <p class="field-note">{[m.company, m.role, m.years].filter(Boolean).join(' · ')}</p>
                  {study.data.outcome && <p class="measure text-ink-2">{typo(study.data.outcome)}</p>}
                </div>
              </a>
              {i === 0 && study.data.phoneScreens && (
                <div class="grid12 mt-10">
                  <div class="content-col max-w-[46rem]">
                    <ScreenPlate screens={study.data.phoneScreens} />
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ol>

      <div class="page mt-10 grid12">
        <div class="content-col">
          <a href="/case-studies" class="arrow-link"><span class="link-text">All case studies</span><span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- §02 Track record -->
    <section class="section">
      <div class="page grid12">
        <div class="label-col lg:pt-2">
          <p class="t-label">§02</p>
          <p class="field-note mt-1 tnum">2017–present</p>
        </div>
        <div class="content-col">
          <h2 class="t-section mb-12">Track record</h2>
          <Ledger rows={career} />
        </div>
      </div>
    </section>

    <!-- §03 Where I'm strongest -->
    <section class="section">
      <div class="page grid12">
        <div class="label-col lg:pt-2">
          <p class="t-label">§03</p>
          <p class="field-note mt-1">Each links to its proof</p>
        </div>
        <div class="content-col">
          <h2 class="t-section mb-12">Where I’m strongest</h2>
          <ul class="ledger">
            {capabilities.map((c) => (
              <li class="ledger-row cap-row">
                <h3 class="font-serif text-[1.5rem] font-light leading-tight tracking-tight">{c.name}</h3>
                <div>
                  <p class="measure">{typo(c.text)}</p>
                  <a href={`/case-studies/${c.slug}`} class="arrow-link t-small mt-3">
                    <span class="link-text">{titleOf(c.slug)}</span><span class="arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
          <p class="field-note mt-8"><span class="text-ink">Tools</span> — {tools}</p>
        </div>
      </div>
    </section>

    <!-- §04 Currently building -->
    <section class="section">
      <div class="page grid12">
        <div class="label-col lg:pt-2">
          <p class="t-label">§04</p>
          <p class="field-note mt-1">Solo build, about 10 h a week</p>
        </div>
        <div class="content-col">
          <h2 class="t-section">Currently building: StoryForge.id</h2>
          <p class="t-lead measure mt-6">
            An AI-powered tool that reads a BRD, flags the gaps and ambiguities, and drafts the clarification questions in Bahasa Indonesia, built for Indonesian product managers.
          </p>
          <p class="mt-6 flex flex-wrap items-baseline gap-x-4">
            <span class="t-label">Status</span>
            <span>In development, built alongside a full-time PM role.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- §05 Contact -->
    <section id="contact" class="section">
      <div class="page grid12">
        <div class="label-col lg:pt-2">
          <p class="t-label">§05</p>
          <p class="field-note mt-1">Email, LinkedIn, CV</p>
        </div>
        <div class="content-col">
          <h2 class="t-page" style="max-width: 18ch">If you’re hiring for senior fintech product work, write to me.</h2>
          <p class="mt-12">
            <CopyEmail class="font-serif font-light tracking-tight text-[clamp(1.25rem,5.4vw,3.5rem)] !decoration-ink-3" />
          </p>
          <p class="mt-8 flex items-center gap-3">
            <span class="signal-dot" aria-hidden="true"></span>
            <span>{site.status}</span>
          </p>
          <p class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="arrow-link"><span class="link-text">LinkedIn</span><span class="arrow" aria-hidden="true">→</span></a>
            <a href={site.cv} download class="arrow-link"><span class="link-text">CV — PDF, {cvSize}</span><span class="arrow" aria-hidden="true">↓</span></a>
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
