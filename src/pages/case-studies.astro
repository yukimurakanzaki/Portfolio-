---
import Layout from '../layouts/Layout.astro';

const caseStudies = [
  {
    id: 1,
    company: 'PT Bussan Auto Finance (BAF)',
    title: 'Zero-Defect Delivery: Coordinating a 19-Person Team Under OJK Compliance',
    subtitle: 'Product Owner & UI/UX Specialist · 2023–Present',
    problem: 'Faced with strict OJK compliance audits and macroeconomic pressures, BAF needed to scale its core system release cycles without risking regulatory or production defects. The organization lacked dedicated Scrum Masters, Business Analysts, or Technical Project Managers, leaving the 19-person engineering team to navigate complex regulatory requirements with manual tracking and fragmented visibility.',
    approach: 'Stepped in to own end-to-end delivery under extreme resource constraints. I designed a custom requirement traceability framework and implemented a zero-defect BRD→FSD engineering handover workflow. Operating as the sole delivery owner, I structured backlog sequencing, optimized Jira dependency mapping, and established rigid definition-of-done criteria to align engineering directly with regulatory constraints.',
    outcome: 'Eliminated delivery blockages and achieved zero major production defects across 3 consecutive release cycles. The traceability framework reduced requirement-level rework by 30%, accelerated cross-team clarification speed by 25%, and established a highly repeatable delivery architecture.',
    tags: ['Zero-Defect Delivery', 'OJK Compliance', 'Delivery Ownership', 'Jira Architecture'],
    impact: ['Zero major defects on regulatory releases', '30% reduction in requirement rework', 'Coordinated 19 engineers without SM/BA/TPM'],
  },
  {
    id: 2,
    company: 'Danamas (Sinarmas Group)',
    title: 'Lending Infrastructure: Shipping 3 Regional Bank Rails Under High Constraints',
    subtitle: 'Fintech · Aug 2022 – Sep 2023',
    problem: 'Scaling Danamas\' P2P lending pool required building direct, highly secure transaction integrations with multiple regional bank partners. With legacy bank APIs, complex compliance constraints, and limited engineering bandwidth, the platform risked significant integration delays and manual reconciliation errors.',
    approach: 'Personally owned the integration architecture and end-to-end delivery lifecycle. I mapped legacy bank API payloads, sequenced complex data-sync dependencies, and authored technical specifications. Under tight timelines, I designed and executed rigorous System Integration Testing (SIT) and User Acceptance Testing (UAT) validation workflows to ensure data integrity and absolute OJK alignment.',
    outcome: 'Successfully shipped integration rails for 3 major regional bank partners ahead of schedule, expanding the active lending pool. Zero transaction discrepancies occurred post-launch, and the structured verification framework became the team\'s blueprint for bank integrations.',
    tags: ['Lending Infrastructure', 'API Integrations', 'SIT/UAT Validation', 'OJK Alignment'],
    impact: ['3 Regional bank integration rails shipped', 'Zero transaction/reconciliation errors', 'Structured SIT/UAT validation framework'],
  },
  {
    id: 3,
    company: 'SiCepat Ekspres',
    title: 'Compounding Throughput: Optimizing Logistics Sprint Velocity by 18% MoM',
    subtitle: 'Logistics · Aug 2021 – Aug 2022',
    problem: 'National logistics courier operations and driver tools were plagued by slow release cycles and high sprint spillover rates. Product backlogs were highly ambiguous and lacked engineering-ready requirements, causing continuous misunderstandings and operational delivery bottlenecks.',
    approach: 'Implemented a systematic requirement breakdown methodology. I deconstructed highly complex, ambiguous business backlogs into granular, engineering-ready EPICs and clean, testable user stories with explicit acceptance criteria. Acted as the sole liaison mapping field operations bottlenecks directly to technical solutions.',
    outcome: 'Compounded sprint velocity by 18% month-over-month and reduced sprint spillover to near-zero. Successfully deployed the driver management platform (web and mobile) nationwide, significantly streamlining local branch operations.',
    tags: ['Sprint Optimization', 'Requirement Engineering', 'Mobile Logistics', 'Backlog Deconstruction'],
    impact: ['18% MoM increase in sprint velocity', 'Near-zero sprint spillovers', 'Deconstructed complex backlogs into testable stories'],
  },
];
---

<Layout title="Case Studies" description="Product case studies from fintech work at Danamas, SiCepat, and BAF.">

  <!-- Header -->
  <section class="py-20 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sky-400 font-semibold text-sm uppercase tracking-widest mb-4">Case Studies</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-white via-sky-400 to-blue-500">
  Work that moved the needle.
      </h1>
      <p class="text-slate-300 text-lg max-w-2xl leading-relaxed">
        Three stories from the field — real problems, real decisions, real outcomes.
      </p>
    </div>
  </section>

  <!-- Case Studies -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">

      {caseStudies.map((cs, i) => (
        <article class="grid lg:grid-cols-5 gap-8 lg:gap-12 p-8 rounded-3xl transition-all duration-300 hover:bg-white/5 hover:shadow-[0_0_30px_-15px_rgba(56,189,248,0.3)] border border-transparent hover:border-white/10 group mb-8">

          <!-- Left: Meta -->
          <div class="lg:col-span-2">
            <div class="sticky top-24">
              <p class="text-sky-400 text-xs font-semibold uppercase tracking-wider mb-2">{cs.company}</p>
              <h2 class="text-2xl font-bold text-white mb-2">{cs.title}</h2>
              <p class="text-slate-500 text-sm mb-6">{cs.subtitle}</p>

              <div class="flex flex-wrap gap-2 mb-8">
                {cs.tags.map(tag => (
                  <span class="px-2 py-0.5 bg-sky-400/10 text-sky-400 text-xs rounded-full border border-sky-400/20">{tag}</span>
                ))}
              </div>

              <!-- Impact -->
              <div class="border border-white/20 rounded-2xl p-5 bg-white/5 backdrop-blur-md shadow-inner transition-transform duration-500 group-hover:scale-[1.02]">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Key Impact</p>
                <ul class="space-y-2">
                  {cs.impact.map(point => (
                    <li class="text-slate-300 text-sm flex items-start gap-2">
                      <svg class="w-4 h-4 text-sky-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Right: Content -->
          <div class="lg:col-span-3 space-y-8">
            <div>
              <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">The Problem</h3>
              <p class="text-slate-300 leading-relaxed">{cs.problem}</p>
            </div>
            <div>
              <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">My Approach</h3>
              <p class="text-slate-300 leading-relaxed">{cs.approach}</p>
            </div>
            <div>
              <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">The Outcome</h3>
              <p class="text-slate-300 leading-relaxed">{cs.outcome}</p>
            </div>
          </div>

        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-slate-400 mb-4">Want to discuss one of these in detail?</p>
      <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 bg-sky-500 hover:bg-sky-400 text-white font-semibold rounded-lg transition-colors">
        Let's Talk
      </a>
    </div>
  </section>

</Layout>
