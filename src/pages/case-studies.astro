---
import Layout from '../layouts/Layout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const caseStudies = await getCollection('case-studies');

// Sort by order ASC, title ASC as tie-breaker
caseStudies.sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.data.title.localeCompare(b.data.title);
});

const filterTags = ['All', 'Payments', '0-to-1', 'Platform', 'Delivery', 'Process'];
---

<Layout title="Case Studies" description="Product case studies showcasing delivery, strategy, and execution.">

  <!-- Header -->
  <section class="py-20 border-b border-slate-200 dark:border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white mb-4">
        Case Studies
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-lg max-w-2xl leading-relaxed">
        Real problems, real decisions, real outcomes — stories from the field.
      </p>
    </div>
  </section>

  <!-- Filter + Cards -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Tag Filter Buttons -->
      <div class="flex flex-wrap gap-2 mb-12" id="filter-buttons">
        {filterTags.map(tag => (
          <button
            data-tag={tag}
            class:list={[
              'px-4 py-2 rounded-full text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-[#2563EB]',
              tag === 'All'
                ? 'bg-[#2563EB] text-white'
                : 'border border-slate-300 dark:border-white/20 text-slate-600 dark:text-slate-300 hover:border-[#2563EB] hover:text-[#2563EB]'
            ]}
          >
            {tag}
          </button>
        ))}
      </div>

      <!-- Case Study Cards Grid -->
      <div class="grid gap-6 md:grid-cols-2" id="case-study-grid">
        {caseStudies.map(entry => (
          <CaseStudyCard
            title={entry.data.title}
            company={entry.data.company}
            summary={entry.data.summary}
            tags={entry.data.tags}
            slug={entry.data.slug}
          />
        ))}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-12">
        <p class="text-slate-500 dark:text-slate-400 text-lg">No case studies match this filter.</p>
      </div>

    </div>
  </section>

</Layout>

<script>
  const buttons = document.querySelectorAll('#filter-buttons button');
  const cards = document.querySelectorAll('#case-study-grid [data-tags]');
  const emptyState = document.getElementById('empty-state');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag');

      // Update active button styling
      buttons.forEach(btn => {
        btn.classList.remove('bg-[#2563EB]', 'text-white');
        btn.classList.add('border', 'border-slate-300', 'dark:border-white/20', 'text-slate-600', 'dark:text-slate-300');
      });
      button.classList.add('bg-[#2563EB]', 'text-white');
      button.classList.remove('border', 'border-slate-300', 'dark:border-white/20', 'text-slate-600', 'dark:text-slate-300');

      // Filter cards
      let visibleCount = 0;
      cards.forEach(card => {
        const cardTags = card.getAttribute('data-tags') || '';
        if (tag === 'All' || cardTags.includes(tag!)) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Show/hide empty state
      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    });
  });
</script>
