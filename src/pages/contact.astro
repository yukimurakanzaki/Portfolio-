---
import Layout from '../layouts/Layout.astro';

const email = 'muhammadadiputra789@gmail.com';
const linkedinUrl = 'https://linkedin.com/in/m-adi-putra';
---

<Layout title="Contact" description="Get in touch with a Senior Product Manager based in Jakarta.">

  <!-- Hero / Heading -->
  <section class="py-20 border-b border-slate-200 dark:border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[#2563EB] font-semibold text-sm uppercase tracking-widest mb-4">Get in Touch</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white mb-6">
        Let's Talk
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-lg max-w-xl leading-relaxed">
        Whether it's a consulting engagement, a PM coaching session, or just a conversation —
        I'm happy to hear what you're working on.
      </p>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 max-w-2xl">

        <!-- Email -->
        <div class="flex flex-col border border-slate-200 dark:border-white/10 rounded-2xl p-8 bg-slate-50 dark:bg-white/5">
          <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-[#2563EB]/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Email</h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-6">
            For formal enquiries, consulting proposals, or longer-form conversations.
          </p>
          <div class="mt-auto flex items-center gap-3">
            <a
              href={`mailto:${email}`}
              class="text-[#2563EB] text-sm font-medium break-all hover:underline focus:outline-none focus:ring-2 focus:ring-[#2563EB] rounded"
            >
              {email}
            </a>
            <button
              id="copy-email-btn"
              type="button"
              class="shrink-0 p-2 rounded-md text-slate-500 dark:text-slate-400 hover:text-[#2563EB] hover:bg-slate-100 dark:hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-[#2563EB]"
              aria-label="Copy email to clipboard"
              data-email={email}
            >
              <!-- Copy icon -->
              <svg id="copy-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <!-- Check icon (shown after copy) -->
              <svg id="check-icon" class="w-4 h-4 hidden text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- LinkedIn -->
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col border border-slate-200 dark:border-white/10 rounded-2xl p-8 bg-slate-50 dark:bg-white/5 hover:border-[#2563EB]/30 hover:shadow-lg transition-all duration-300 hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-[#2563EB]"
        >
          <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-[#2563EB]/10 flex items-center justify-center mb-6 group-hover:bg-blue-100 dark:group-hover:bg-[#2563EB]/20 transition-colors">
            <svg class="w-6 h-6 text-[#2563EB]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-[#2563EB] transition-colors">LinkedIn</h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-6">
            Connect with me on LinkedIn for professional networking and updates.
          </p>
          <div class="mt-auto flex items-center gap-2 text-[#2563EB] text-sm font-medium">
            <span>View Profile</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Location & Availability -->
  <section class="py-16 border-t border-slate-200 dark:border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6">Location &amp; Availability</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <div class="flex flex-col border border-slate-200 dark:border-white/10 rounded-2xl p-6 bg-slate-50 dark:bg-white/5">
          <div class="w-8 h-8 rounded-lg bg-[#2563EB]/10 flex items-center justify-center mb-4">
            <svg class="w-4 h-4 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Based in</p>
          <p class="text-slate-900 dark:text-white font-semibold text-sm">Jakarta, Indonesia</p>
          <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Open to WFO &amp; hybrid roles</p>
        </div>

        <div class="flex flex-col border border-slate-200 dark:border-white/10 rounded-2xl p-6 bg-slate-50 dark:bg-white/5">
          <div class="w-8 h-8 rounded-lg bg-[#2563EB]/10 flex items-center justify-center mb-4">
            <svg class="w-4 h-4 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Timezone</p>
          <p class="text-slate-900 dark:text-white font-semibold text-sm">WIB · UTC+7</p>
          <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Western Indonesia Time</p>
        </div>

        <div class="flex flex-col border border-slate-200 dark:border-white/10 rounded-2xl p-6 bg-slate-50 dark:bg-white/5">
          <div class="w-8 h-8 rounded-lg bg-[#2563EB]/10 flex items-center justify-center mb-4">
            <svg class="w-4 h-4 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
          </div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Remote</p>
          <p class="text-slate-900 dark:text-white font-semibold text-sm">Open to remote</p>
          <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Comfortable with async work</p>
        </div>

        <div class="flex flex-col border border-slate-200 dark:border-white/10 rounded-2xl p-6 bg-slate-50 dark:bg-white/5">
          <div class="w-8 h-8 rounded-lg bg-[#2563EB]/10 flex items-center justify-center mb-4">
            <svg class="w-4 h-4 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
            </svg>
          </div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Relocation</p>
          <p class="text-slate-900 dark:text-white font-semibold text-sm">SG &amp; KL open</p>
          <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">18–24 month horizon</p>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');

      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 2000);
    } catch {
      // Fallback for older browsers
      const textarea = document.createElement('textarea');
      textarea.value = email;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);

      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');

      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 2000);
    }
  });
</script>
