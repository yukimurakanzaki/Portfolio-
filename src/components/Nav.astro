---
import ThemeToggle from './ThemeToggle.astro';
import Mark from './Mark.astro';
import { site, nav } from '../lib/site';

const { currentPath } = Astro.props;
const path = currentPath.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : path.startsWith(href + '/') ? 'true' : undefined);
---

<header class="site-header">
  <div class="page nav-row">
    <a href="/" class="wordmark"><Mark size={18} /><span>{site.name}</span></a>
    <nav class="nav-links" aria-label="Primary">
      {nav.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-4">
      <ThemeToggle />
      <button type="button" class="menu-btn" id="menu-open" aria-haspopup="dialog">Menu</button>
    </div>
  </div>
</header>

<dialog id="menu" class="menu-dialog" aria-label="Menu">
  <div class="page nav-row">
    <span class="t-label">Menu</span>
    <button type="button" class="menu-btn" id="menu-close" style="display:inline-block">Close</button>
  </div>
  <nav class="page menu-links" aria-label="Mobile" style="flex:1; overflow-y:auto; padding-top:1.5rem;">
    {nav.map((l, i) => (
      <a href={l.href} aria-current={current(l.href)}>
        <span class="field-note tnum">{String(i + 1).padStart(2, '0')}</span>{l.label}
      </a>
    ))}
  </nav>
</dialog>

<script>
  const menu = document.getElementById('menu') as HTMLDialogElement | null;
  document.getElementById('menu-open')?.addEventListener('click', () => menu?.showModal());
  document.getElementById('menu-close')?.addEventListener('click', () => menu?.close());
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && menu?.close());
</script>
