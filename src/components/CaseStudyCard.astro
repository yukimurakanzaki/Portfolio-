---
interface Props {
  title: string;
  company: string;
  summary: string;
  tags: string[];
  slug: string;
  featured?: boolean;
}

const { title, company, summary, tags, slug, featured = false } = Astro.props;
---

<a
  href={`/case-studies/${slug}`}
  class:list={[
    'group block border border-slate-200 dark:border-white/10 rounded-2xl bg-slate-50 dark:bg-white/5 hover:bg-white dark:hover:bg-white/10 hover:border-[#2563EB]/30 hover:shadow-lg transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-[#2563EB]',
    featured ? 'p-8 sm:p-10 grid md:grid-cols-2 gap-6 items-start' : 'p-8'
  ]}
  data-tags={tags.join(',')}
>
  <div>
    <p class="text-[#2563EB] text-xs font-semibold uppercase tracking-wider mb-2">{company}</p>
    <h3 class:list={['text-slate-900 dark:text-white font-bold group-hover:text-[#2563EB] transition-colors', featured ? 'text-2xl mb-4' : 'text-lg mb-3']}>{title}</h3>
    {!featured && <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">{summary}</p>}
  </div>
  <div class:list={[featured && 'md:pt-6']}>
    {featured && <p class="text-slate-600 dark:text-slate-400 text-base leading-relaxed mb-6">{summary}</p>}
    <div class="flex flex-wrap gap-2">
      {tags.map(tag => (
        <span class="px-3 py-1 border border-[#2563EB]/20 text-[#2563EB] dark:text-blue-400 text-xs rounded-full">{tag}</span>
      ))}
    </div>
    {featured && (
      <span class="inline-flex items-center gap-1.5 mt-6 text-[#2563EB] text-sm font-medium group-hover:gap-2.5 transition-all duration-300">
        Read case study
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    )}
  </div>
</a>
