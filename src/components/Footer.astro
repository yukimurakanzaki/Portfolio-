---
import { site } from '../lib/site';
const { meridian = true } = Astro.props;
---
<footer class:list={['border-t border-rule', meridian && 'meridian']}>
  <div class="page grid12 field-note footer-line">
    <span class="label-col">© {new Date().getFullYear()} {site.name}</span>
    <div class="content-col">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={site.cv} download>CV</a>
      <a href="/how-i-built-this">Colophon</a>
      <span>{site.coords}</span>
    </div>
  </div>
</footer>
